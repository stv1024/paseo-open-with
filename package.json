{
  "name": "paseo-open-with",
  "private": true,
  "version": "0.2.0",
  "files": [
    "assets/",
    "paseo-plugin.json",
    "OVERVIEW.md",
    "OVERVIEW.*.md",
    "index.client.ts",
    "index.client.tsx",
    "index.server.ts",
    "index.server.tsx",
    "client/",
    "server/",
    "shared/",
    "docs/images/*.png",
    "LICENSE",
    "!**/*.test.ts"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "tsx --test server/*.test.ts",
    "pack:npm": "node scripts/pack-npm.mjs"
  },
  "devDependencies": {
    "@getpaseo/plugin": "0.13.2",
    "@tanstack/react-query": "^5.90.11",
    "@types/node": "^22.20.5",
    "@types/react": "~19.2.0",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "zod": "^4.4.3"
  },
  "description": "Paseo plugin: open the workspace folder, or a file link in an agent reply, in Fork, GitHub Desktop, VS Code, Cursor, a terminal, or any app you add. Right-click a file link or image to show it in its folder or copy its path.",
  "author": "stv1024",
  "homepage": "https://github.com/stv1024/paseo-open-with#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stv1024/paseo-open-with.git"
  },
  "bugs": {
    "url": "https://github.com/stv1024/paseo-open-with/issues"
  },
  "license": "MIT",
  "keywords": [
    "paseo",
    "paseo-plugin",
    "open-with",
    "fork",
    "editor",
    "file",
    "links",
    "context-menu"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
